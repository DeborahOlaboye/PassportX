# PassportX Environment Configuration
# This is the master environment template. Copy this file to .env and fill in the values.
# Required variables must be set for the application to start. Optional variables have defaults.

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# Database Configuration
# MongoDB connection string - required for database operations
MONGODB_URI=mongodb://localhost:27017/passportx

# Authentication
# JWT secret key for signing tokens - required for user authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT token expiration time
JWT_EXPIRES_IN=7d

# Application Configuration
# Node environment - affects logging and behavior
NODE_ENV=development
# Backend server port
PORT=3001
# Frontend application URL for CORS and redirects
FRONTEND_URL=http://localhost:3000
# Backend API base URL for internal (server-side) API calls.
# This is the canonical variable used by all Next.js API route proxies.
# Aliases BACKEND_API_URL and NEXT_PUBLIC_API_URL are accepted for backward
# compatibility but BACKEND_URL is preferred.
BACKEND_URL=http://localhost:3001

# Blockchain Configuration
# Stacks network to use: devnet, testnet, mainnet
STACKS_NETWORK=devnet
# Stacks API endpoint URL
STACKS_API_URL=https://api.testnet.hiro.so

# Contract Addresses
# Passport core contract address
PASSPORT_CONTRACT_ADDRESS=
# Badge issuer contract address
BADGE_ISSUER_CONTRACT_ADDRESS=
# Community manager contract address
COMMUNITY_MANAGER_CONTRACT_ADDRESS=

# Devnet Contract Addresses (used when STACKS_NETWORK=devnet)
DEVNET_BADGE_READER_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_BADGE_ISSUER_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_BADGE_METADATA_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_PASSPORT_NFT_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_PASSPORT_CORE_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_COMMUNITY_MANAGER_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_ACCESS_CONTROL_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM

# Testnet Contract Addresses (used when STACKS_NETWORK=testnet)
TESTNET_BADGE_READER_ADDRESS=
TESTNET_BADGE_ISSUER_ADDRESS=
TESTNET_BADGE_METADATA_ADDRESS=
TESTNET_PASSPORT_NFT_ADDRESS=
TESTNET_PASSPORT_CORE_ADDRESS=
TESTNET_COMMUNITY_MANAGER_ADDRESS=
TESTNET_ACCESS_CONTROL_ADDRESS=

# Mainnet Contract Addresses (used when STACKS_NETWORK=mainnet)
MAINNET_BADGE_READER_ADDRESS=
MAINNET_BADGE_ISSUER_ADDRESS=
MAINNET_BADGE_METADATA_ADDRESS=
MAINNET_PASSPORT_NFT_ADDRESS=
MAINNET_PASSPORT_CORE_ADDRESS=
MAINNET_COMMUNITY_MANAGER_ADDRESS=
MAINNET_ACCESS_CONTROL_ADDRESS=

# Frontend Configuration (NEXT_PUBLIC_ variables are exposed to the browser)
# WalletConnect project ID from https://dashboard.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
# Application name displayed in wallet connections
NEXT_PUBLIC_APP_NAME=PassportX
# Application URL for wallet metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Stacks network for frontend: testnet or mainnet
NEXT_PUBLIC_STACKS_NETWORK=testnet
# Stacks API URL for frontend
NEXT_PUBLIC_STACKS_API_URL=https://api.testnet.hiro.so
# Passport contract address for frontend
NEXT_PUBLIC_PASSPORT_CONTRACT_ADDRESS=
# Badge issuer contract address for frontend
NEXT_PUBLIC_BADGE_ISSUER_CONTRACT_ADDRESS=
# Community manager contract address for frontend
NEXT_PUBLIC_COMMUNITY_MANAGER_CONTRACT_ADDRESS=

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-in-production
SESSION_MAX_AGE=604800000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Blockchain Explorer
BLOCKCHAIN_EXPLORER_URL=https://explorer.stacks.co

# Feature Flags
ENABLE_BADGE_VERIFICATION=true
ENABLE_ANALYTICS=true

# Monitoring and Logging
SENTRY_DSN=
LOG_LEVEL=info

# Chainhook Configuration
CHAINHOOK_NODE_URL=http://localhost:20456
CHAINHOOK_NODE_API_KEY=
CHAINHOOK_NODE_TIMEOUT=30000
CHAINHOOK_NODE_RETRY_ENABLED=true
CHAINHOOK_NODE_MAX_RETRIES=3
CHAINHOOK_NODE_RETRY_DELAY=1000
CHAINHOOK_SERVER_HOST=localhost
CHAINHOOK_SERVER_PORT=3010
CHAINHOOK_SERVER_EXTERNAL_URL=http://localhost:3010
CHAINHOOK_SERVER_HTTPS=false
CHAINHOOK_SERVER_SSL_CERT_PATH=
CHAINHOOK_SERVER_SSL_KEY_PATH=
CHAINHOOK_WEBHOOK_URL=http://localhost:3010/api/community-creation/webhook/events
CHAINHOOK_AUTH_TOKEN=
CHAINHOOK_ENABLE_EVENT_PREDICATE=false
CHAINHOOK_ENABLE_BADGE_MINT=true
CHAINHOOK_ENABLE_BADGE_MINT_EVENT=false
BADGE_MINT_WEBHOOK_URL=http://localhost:3010/api/badges/webhook/mint
CHAINHOOK_ENABLE_BADGE_METADATA_UPDATE=true
CHAINHOOK_ENABLE_BADGE_METADATA_UPDATE_EVENT=false
BADGE_METADATA_WEBHOOK_URL=http://localhost:3010/api/badges/webhook/metadata
CHAINHOOK_ENABLE_BADGE_REVOCATION=true

# Notification System Configuration
# Email notification settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@passportx.app

# WebSocket notification settings
NOTIFICATION_WEBSOCKET_PORT=3011
NOTIFICATION_WEBSOCKET_HOST=localhost
ENABLE_NOTIFICATION_WEBSOCKET=true
CHAINHOOK_ENABLE_BADGE_REVOCATION_EVENT=false
BADGE_REVOCATION_WEBHOOK_URL=http://localhost:3010/api/badges/webhook/revocation
WEBHOOK_SIGNATURE_VALIDATION=false
WEBHOOK_SIGNATURE_ALGORITHM=sha256
WEBHOOK_SECRET_KEY=
BADGE_METADATA_WEBHOOK_SECRET=default-secret
BADGE_REVOCATION_WEBHOOK_SECRET=default-secret

# Legacy Chainhook (deprecated)
CHAINHOOK_START_BLOCK=0
CHAINHOOK_EVENT_QUEUE=chainhook-events
CHAINHOOK_MAX_BATCH_SIZE=100

# Monitoring Configuration
CHAINHOOK_HEALTH_CHECK_INTERVAL=30000
CHAINHOOK_METRICS_INTERVAL=60000
CHAINHOOK_LOG_RETENTION_DAYS=30
CHAINHOOK_PERF_THRESHOLD=5000
CHAINHOOK_FAILURE_RATE_THRESHOLD=10
CHAINHOOK_MAX_CONSECUTIVE_FAILURES=5
MONITORING_DASHBOARD_URL=http://localhost:3000/monitoring

# Reorg Handling
REORG_MAX_ROLLBACK_DEPTH=100
REORG_MONITORING_ENABLED=true
REORG_CACHE_TTL_MS=300000
REORG_DATABASE_LOG_RETENTION_HOURS=24
REORG_DEEP_REORG_BLOCKS=10
REORG_FREQUENT_REORG_PER_HOUR=5
REORG_LARGE_IMPACT_TRANSACTIONS=100
REORG_CLEANUP_INTERVAL_MS=3600000
REORG_MAX_ROLLBACK_OPERATIONS=10000

# WalletConnect Configuration
NEXT_PUBLIC_WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.org
NEXT_PUBLIC_WALLETCONNECT_DEBUG=false
NEXT_PUBLIC_WALLETCONNECT_ENABLED=true
NEXT_PUBLIC_WALLETCONNECT_NETWORK=testnet
NEXT_PUBLIC_CHAIN_ID=5
NEXT_PUBLIC_RPC_URL=https://goerli.infura.io/v3/
NEXT_PUBLIC_CHAIN_NAME=Ethereum Testnet (Goerli)
WALLETCONNECT_PROJECT_ID=your_testnet_project_id_here
WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.org
WALLETCONNECT_TEST_MODE=true
WALLETCONNECT_LOG_LEVEL=debug
WALLETCONNECT_TIMEOUT=30000
WALLETCONNECT_DEPLOYMENT_APPROVAL_REQUIRED=false
WALLETCONNECT_REQUIRE_SECURITY_AUDIT=false

# Additional Frontend Variables
NEXT_PUBLIC_ANALYTICS_API_URL=/api/analytics
NEXT_PUBLIC_EXPLORER_URL=https://explorer.stacks.co
NEXT_PUBLIC_SOCKET_URL=http://localhost:3010
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Deprecated: use BACKEND_URL for server-side route proxies instead.
# NEXT_PUBLIC_BACKEND_URL and NEXT_PUBLIC_BACKEND_API_URL are accepted as
# fallback aliases in @/lib/config but should not be used in new code.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001
BACKEND_API_KEY=
NEXT_PUBLIC_CHAINHOOK_ENABLED=true
NEXT_PUBLIC_CHAINHOOK_DEBUG=false
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_MAINNET_COMMUNITY_MANAGER_ADDRESS=
NEXT_PUBLIC_TESTNET_COMMUNITY_MANAGER_ADDRESS=
NEXT_PUBLIC_MAINNET_BADGE_ISSUER_ADDRESS=
NEXT_PUBLIC_TESTNET_BADGE_ISSUER_ADDRESS=

# Deployment and Testing
DEPLOYER_PRIVATE_KEY=your-deployer-private-key
COMMUNITY_APPROVERS=
ANALYZE=false
WC_ENABLED=0
WC_TESTNET_URL=https://stacks-node-api.testnet.example
WC_PRIVATE_KEY=your_test_private_key_here
EVENT_COUNT=10000
BATCH_SIZE=50
EVENT_SIZE=medium
CONCURRENCY=5
