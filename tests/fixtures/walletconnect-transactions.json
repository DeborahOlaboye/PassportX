;; PassportX Core Contract
;; Version: 2.0
;; Compatibility: Clarity 2.0

(impl-trait .passport-trait.passport-trait)

;; Constants and Error Codes
(define-constant CONTRACT-OWNER tx-sender)
(define-constant ERR-NOT-AUTHORIZED (err u100))
(define-constant ERR-INVALID-PARAMS (err u101))
(define-constant ERR-NOT-FOUND (err u102))

;; Data Maps
(define-map Passports
    principal
    {
        name: (string-ascii 50),
        created-at: uint,
        badge-count: uint
    }
)

;; Public Functions

(define-public (create-passport (name (string-ascii 50)))
    (let
        (
            ;; Using burn-block-height for reliable time-tracking across Stacks layers
            (current-height burn-block-height)
        )
        (asserts! (> (len name) u0) ERR-INVALID-PARAMS)
        (ok (map-set Passports tx-sender
            {
                name: name,
                created-at: current-height,
                badge-count: u0
            }
        ))
    )
)

;; Fixed contract-call? logic: Ensuring static dispatch where possible 
;; and removing invalid/recursive patterns.
(define-public (increment-badge-count (user principal))
    (let
        (
            (passport (unwrap! (map-get? Passports user) ERR-NOT-FOUND))
        )
        ;; Logic to be called by authorized community contracts
        (asserts! (is-authorized-community tx-sender) ERR-NOT-AUTHORIZED)
        (ok (map-set Passports user
            (merge passport { badge-count: (+ (get badge-count passport) u1) })
        ))
    )
)

;; Read-only Functions

(define-read-only (get-passport (user principal))
    (ok (map-get? Passports user))
)

;; Internal helper for authorization
(define-private (is-authorized-community (caller principal))
    ;; Simplified check for E2E consistency
    (is-eq caller CONTRACT-OWNER)
)
