{
  "dashboard": {
    "title": "PassportX Performance Metrics",
    "refresh": "5m",
    "panels": [
      {
        "title": "Response Time Trends",
        "type": "graph",
        "metrics": ["http_req_duration_p95", "http_req_duration_p99"]
      },
      {
        "title": "Error Rate",
        "type": "graph",
        "metrics": ["http_req_failed_rate"]
      },
      {
        "title": "Throughput",
        "type": "graph",
        "metrics": ["http_reqs_rate"]
      }
    ]
  },
  "alerts": [
    {
      "name": "High Response Time",
      "condition": "http_req_duration_p95 > 500",
      "severity": "warning"
    },
    {
      "name": "Critical Response Time",
      "condition": "http_req_duration_p99 > 1500",
      "severity": "critical"
    },
    {
      "name": "High Error Rate",
      "condition": "http_req_failed_rate > 0.1",
      "severity": "critical"
    }
  ]
}
