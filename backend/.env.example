# PassportX Backend Environment Configuration
# This file contains the required environment variables for the backend.
# For a complete list with optional variables, see the root .env.example

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/passportx

# Authentication
# REQUIRED – must be a strong, randomly-generated secret (min 32 chars).
# The server will refuse to start if this is missing or matches a known
# placeholder. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Blockchain Configuration
STACKS_NETWORK=devnet
STACKS_API_URL=https://api.testnet.hiro.so

# Contract Addresses
PASSPORT_CONTRACT_ADDRESS=
BADGE_ISSUER_CONTRACT_ADDRESS=
COMMUNITY_MANAGER_CONTRACT_ADDRESS=

# Error Monitoring & Notifications
SLACK_WEBHOOK_URL=
ERROR_EMAIL_ENABLED=false
ERROR_EMAIL_TO=admin@example.com

# Security Alerts
SLACK_SECURITY_WEBHOOK_URL=
SECURITY_EMAIL_ENABLED=false
SECURITY_EMAIL_TO=security@example.com
