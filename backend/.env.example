# PassportX Backend Environment Configuration
# Copy this file to .env and fill in all required values before starting the server.
# The server will refuse to start if MONGODB_URI or JWT_SECRET are missing.
#
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# =============================================================================
# REQUIRED — Server will exit(1) if these are missing or set to placeholders
# =============================================================================

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/passportx

# JWT signing secret — must be a strong random value (min 32 chars)
JWT_SECRET=

# JWT token expiry
JWT_EXPIRES_IN=7d

# =============================================================================
# APPLICATION
# =============================================================================

NODE_ENV=development
PORT=3001

# Frontend URL used for CORS allow-list and redirect construction
FRONTEND_URL=http://localhost:3000

# Backend base URL used for internal self-referencing links
BACKEND_URL=http://localhost:3001

# Comma-separated list of allowed CORS origins (overrides FRONTEND_URL)
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# BLOCKCHAIN / STACKS NETWORK
# =============================================================================

# Target network: devnet | testnet | mainnet
STACKS_NETWORK=devnet

# Hiro Stacks API base URL
STACKS_API_URL=https://api.testnet.hiro.so

# =============================================================================
# CONTRACT ADDRESSES — Devnet (STACKS_NETWORK=devnet)
# =============================================================================

DEVNET_BADGE_READER_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_BADGE_ISSUER_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_BADGE_METADATA_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_PASSPORT_NFT_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_PASSPORT_CORE_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_COMMUNITY_MANAGER_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
DEVNET_ACCESS_CONTROL_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM

# =============================================================================
# CONTRACT ADDRESSES — Testnet (STACKS_NETWORK=testnet)
# =============================================================================

TESTNET_BADGE_READER_ADDRESS=
TESTNET_BADGE_ISSUER_ADDRESS=
TESTNET_BADGE_METADATA_ADDRESS=
TESTNET_PASSPORT_NFT_ADDRESS=
TESTNET_PASSPORT_CORE_ADDRESS=
TESTNET_COMMUNITY_MANAGER_ADDRESS=
TESTNET_ACCESS_CONTROL_ADDRESS=

# =============================================================================
# CONTRACT ADDRESSES — Mainnet (STACKS_NETWORK=mainnet)
# =============================================================================

MAINNET_BADGE_READER_ADDRESS=
MAINNET_BADGE_ISSUER_ADDRESS=
MAINNET_BADGE_METADATA_ADDRESS=
MAINNET_PASSPORT_NFT_ADDRESS=
MAINNET_PASSPORT_CORE_ADDRESS=
MAINNET_COMMUNITY_MANAGER_ADDRESS=
MAINNET_ACCESS_CONTROL_ADDRESS=

# Convenience aliases used in some services
PASSPORT_CONTRACT_ADDRESS=
BADGE_ISSUER_CONTRACT_ADDRESS=
COMMUNITY_MANAGER_CONTRACT_ADDRESS=
COMMUNITY_MANAGER_CONTRACT=

# =============================================================================
# CHAINHOOK NODE CONNECTION
# =============================================================================

# URL of the Chainhook node REST API
CHAINHOOK_NODE_URL=http://localhost:20456

# API key for Hiro-hosted nodes (testnet/mainnet only)
CHAINHOOK_NODE_API_KEY=

# Request timeout in milliseconds
CHAINHOOK_NODE_TIMEOUT=30000

# Reconnection settings
CHAINHOOK_NODE_RETRY_ENABLED=true
CHAINHOOK_NODE_MAX_RETRIES=3
CHAINHOOK_NODE_RETRY_DELAY=1000

# First block to index from (0 = chain genesis)
CHAINHOOK_START_BLOCK=0

# Internal event queue name
CHAINHOOK_EVENT_QUEUE=chainhook-events

# Maximum events per delivery batch
CHAINHOOK_MAX_BATCH_SIZE=100

# Auth token embedded in predicate authorization_header — must match WEBHOOK_SECRET_KEY
CHAINHOOK_AUTH_TOKEN=

# =============================================================================
# CHAINHOOK PREDICATE FEATURE FLAGS
# All predicates are disabled by default. Enable only what you need.
# =============================================================================

# Community creation predicate is always on — no flag needed.

CHAINHOOK_ENABLE_BADGE_MINT=false
CHAINHOOK_ENABLE_BADGE_MINT_EVENT=false

CHAINHOOK_ENABLE_BADGE_METADATA_UPDATE=false
CHAINHOOK_ENABLE_BADGE_METADATA_UPDATE_EVENT=false

CHAINHOOK_ENABLE_BADGE_REVOCATION=false
CHAINHOOK_ENABLE_BADGE_REVOCATION_EVENT=false

# Shortcut: enables all *_EVENT print predicates at once (useful in development)
CHAINHOOK_ENABLE_EVENT_PREDICATE=false

# =============================================================================
# WEBHOOK DELIVERY URLs
# These are embedded in predicates. In Docker, replace localhost with
# host.docker.internal so the Chainhook container can reach the backend.
# =============================================================================

CHAINHOOK_WEBHOOK_URL=http://localhost:3001/api/community-creation/webhook/events
BADGE_MINT_WEBHOOK_URL=http://localhost:3001/api/badges/webhook/mint
BADGE_METADATA_WEBHOOK_URL=http://localhost:3001/api/badges/webhook/metadata
BADGE_REVOCATION_WEBHOOK_URL=http://localhost:3001/api/badges/webhook/revocation

# =============================================================================
# WEBHOOK SIGNATURE VERIFICATION
# The backend verifies an HMAC-SHA256 signature on every inbound Chainhook POST.
# WEBHOOK_SECRET_KEY must equal CHAINHOOK_AUTH_TOKEN above.
# =============================================================================

# Set to true in production — disable only for local development
WEBHOOK_SIGNATURE_VALIDATION=false

# Secret key used to compute and verify HMAC signatures
WEBHOOK_SECRET_KEY=

# Hash algorithm (must match what Chainhook uses)
WEBHOOK_SIGNATURE_ALGORITHM=sha256

# Per-webhook secrets used by legacy middleware
# REQUIRED — server exits if these are missing or set to 'default-secret'
BADGE_METADATA_WEBHOOK_SECRET=
BADGE_REVOCATION_WEBHOOK_SECRET=

# =============================================================================
# CHAINHOOK MONITORING AND PERFORMANCE
# =============================================================================

# Health check interval in ms (default 30s)
CHAINHOOK_HEALTH_CHECK_INTERVAL=30000

# Metrics collection interval in ms (default 60s)
CHAINHOOK_METRICS_INTERVAL=60000

# How long to retain event logs in days
CHAINHOOK_LOG_RETENTION_DAYS=30

# Performance warning threshold in ms (alert if event takes longer)
CHAINHOOK_PERF_THRESHOLD=5000

# Alert if error rate exceeds this percentage
CHAINHOOK_FAILURE_RATE_THRESHOLD=10

# Alert after this many consecutive failures
CHAINHOOK_MAX_CONSECUTIVE_FAILURES=5

# =============================================================================
# CHAIN REORG HANDLING
# =============================================================================

REORG_MONITORING_ENABLED=true

# Maximum block depth the rollback handler will reverse
REORG_MAX_ROLLBACK_DEPTH=100

# Maximum individual DB operations in a single rollback
REORG_MAX_ROLLBACK_OPERATIONS=10000

# How long to cache reorg state in ms (default 5 min)
REORG_CACHE_TTL_MS=300000

# How long to keep rollback log entries in hours
REORG_DATABASE_LOG_RETENTION_HOURS=24

# Block depth that qualifies as a "deep reorg" alert
REORG_DEEP_REORG_BLOCKS=10

# Reorgs per hour before "frequent reorg" alert fires
REORG_FREQUENT_REORG_PER_HOUR=5

# Transactions affected before "large impact" alert fires
REORG_LARGE_IMPACT_TRANSACTIONS=100

# Interval for cleaning up expired rollback log entries in ms
REORG_CLEANUP_INTERVAL_MS=3600000

# =============================================================================
# ALERTING AND ERROR MONITORING
# =============================================================================

# Slack webhook URL for operational error alerts (optional)
SLACK_WEBHOOK_URL=

# Email error notifications
ERROR_EMAIL_ENABLED=false
ERROR_EMAIL_TO=admin@example.com

# Slack webhook URL for security-related alerts (optional)
SLACK_SECURITY_WEBHOOK_URL=

# Email security notifications
SECURITY_EMAIL_ENABLED=false
SECURITY_EMAIL_TO=security@example.com

# SMTP configuration (required when any *_EMAIL_ENABLED=true)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@passportx.app

# =============================================================================
# COMMUNITY SETTINGS
# =============================================================================

# Comma-separated list of Stacks addresses allowed to approve communities
COMMUNITY_APPROVERS=

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================

SESSION_SECRET=
SESSION_MAX_AGE=604800000
