# .npmrc - npm configuration for PassportX

# Use exact versions from package-lock.json
ci=true

# Automatically save exact versions
save-exact=false

# Enable peer dependency warnings
legacy-peer-deps=false

# Set production mode
production=false

# Enable verbose logging for debugging
loglevel=warn

# Configure npm registry
registry=https://registry.npmjs.org/

# Strict peer dependency management
strict-peer-deps=false

# Progress bar in CI environments
progress=true
