# .env.dependencies.example
# Environment variables for dependency management and npm configuration

# NPM Configuration
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
NPM_CONFIG_LOGLEVEL=warn
NPM_CONFIG_PROGRESS=true

# Build Configuration
NODE_ENV=development
NODE_VERSION=18.0.0

# Dependency Resolution
NPM_LEGACY_PEER_DEPS=false
NPM_STRICT_PEER_DEPS=false

# CI/CD Configuration
CI=false
CONTINUOUS_INTEGRATION=false

# Private Registry Configuration (if using private npm registry)
# NPM_TOKEN=your_token_here
# PRIVATE_REGISTRY_URL=https://private-registry.com/

# Security and Auditing
NPM_AUDIT_LEVEL=moderate
NPM_AUDIT_FIX=true

# Cache Configuration
NPM_CACHE_MIN=10
NPM_CACHE_STRICT=false

# Proxy Configuration (if behind corporate proxy)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# Dependency Version Constraints
# Allow specifying custom version constraints
STACKS_VERSION=6.0.0
REACT_VERSION=18.2.0
NEXT_VERSION=14.0.0
WALLETCONNECT_VERSION=2.23.1
